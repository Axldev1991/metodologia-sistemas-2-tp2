@startuml diagrama_strategy
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam class {
    BackgroundColor White
    ArrowColor #2C3E50
    BorderColor #2C3E50
}

title Patrón Strategy - Gestión de Transacciones Bancarias (Punto 1)

class GestorTransacciones <<Context>> {
    - monto: BigDecimal
    + GestorTransacciones()
    + GestorTransacciones(estrategiaInicial: TransaccionStrategy)
    + setEstrategia(estrategia: TransaccionStrategy): void
    + getEstrategia(): TransaccionStrategy
    + prepararTransaccion(monto: BigDecimal, origen: CuentaBancaria, destino: CuentaBancaria): void
    + confirmarTransaccion(): void
}

interface TransaccionStrategy <<Strategy>> {
    + {abstract} ejecutar(monto: BigDecimal, cuentaOrigen: CuentaBancaria, cuentaDestino: CuentaBancaria): void
}

class DepositoStrategy <<ConcreteStrategy>> {
    + ejecutar(monto: BigDecimal, cuentaOrigen: CuentaBancaria, cuentaDestino: CuentaBancaria): void
}

class ExtraccionStrategy <<ConcreteStrategy>> {
    + ejecutar(monto: BigDecimal, cuentaOrigen: CuentaBancaria, cuentaDestino: CuentaBancaria): void
}

class TransferenciaStrategy <<ConcreteStrategy>> {
    + ejecutar(monto: BigDecimal, cuentaOrigen: CuentaBancaria, cuentaDestino: CuentaBancaria): void
}

class CuentaBancaria {
    - cbu: String
    - titular: String
    - saldo: BigDecimal
    + CuentaBancaria(cbu: String, titular: String, saldoInicial: BigDecimal)
    + getCbu(): String
    + getTitular(): String
    + getSaldo(): BigDecimal
    + acreditar(monto: BigDecimal): void
    + debitar(monto: BigDecimal): void
}

' Relación Contexto -> Estrategia (Agregación / Asociación dirigida con rol y multiplicidad)
GestorTransacciones o--> "1\n-estrategia" TransaccionStrategy

' Relaciones de Realización / Implementación (la flecha hueca discontinua ya significa realización)
TransaccionStrategy <|.. DepositoStrategy
TransaccionStrategy <|.. ExtraccionStrategy
TransaccionStrategy <|.. TransferenciaStrategy

' Asociaciones del contexto con las cuentas de dominio
GestorTransacciones --> "1\n-cuentaOrigen" CuentaBancaria
GestorTransacciones --> "0..1\n-cuentaDestino" CuentaBancaria

' Dependencias de uso de las estrategias con el dominio (flecha discontinua simple)
DepositoStrategy ..> CuentaBancaria
ExtraccionStrategy ..> CuentaBancaria
TransferenciaStrategy ..> CuentaBancaria

@enduml
