@startuml diagrama_strategy
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 50
skinparam class {
    BackgroundColor White
    ArrowColor #2C3E50
    BorderColor #2C3E50
}

title Patrón Strategy - Gestión de Transacciones Bancarias (Punto 1)

' Columna Izquierda: Contexto y Entidad de Dominio
class GestorTransacciones <<Context>> {
    - monto: BigDecimal
    + GestorTransacciones()
    + GestorTransacciones(estrategiaInicial: TransaccionStrategy)
    + setEstrategia(estrategia: TransaccionStrategy): void
    + getEstrategia(): TransaccionStrategy
    + prepararTransaccion(monto: BigDecimal, origen: CuentaBancaria, destino: CuentaBancaria): void
    + confirmarTransaccion(): void
}

class CuentaBancaria {
    - cbu: String
    - titular: String
    - saldo: BigDecimal
    + CuentaBancaria(cbu: String, titular: String, saldoInicial: BigDecimal)
    + getCbu(): String
    + getTitular(): String
    + getSaldo(): BigDecimal
    + acreditar(monto: BigDecimal): void
    + debitar(monto: BigDecimal): void
}

' Columna Derecha: Interfaz Strategy y Estrategias Concretas
interface TransaccionStrategy <<Strategy>> {
    + {abstract} ejecutar(monto: BigDecimal, origen: CuentaBancaria, destino: CuentaBancaria): void
}

class DepositoStrategy <<ConcreteStrategy>> {
    + ejecutar(monto: BigDecimal, origen: CuentaBancaria, destino: CuentaBancaria): void
}

class ExtraccionStrategy <<ConcreteStrategy>> {
    + ejecutar(monto: BigDecimal, origen: CuentaBancaria, destino: CuentaBancaria): void
}

class TransferenciaStrategy <<ConcreteStrategy>> {
    + ejecutar(monto: BigDecimal, origen: CuentaBancaria, destino: CuentaBancaria): void
}

' Relación Contexto -> Strategy (Horizontal hacia la derecha)
GestorTransacciones o-right-> "1\n-estrategia" TransaccionStrategy

' Relaciones Contexto -> Cuentas de Dominio (Hacia abajo en la columna izquierda)
GestorTransacciones -down-> "1\n-cuentaOrigen" CuentaBancaria
GestorTransacciones -down-> "0..1\n-cuentaDestino" CuentaBancaria

' Implementaciones concretas debajo de la interfaz
TransaccionStrategy <|.. DepositoStrategy
TransaccionStrategy <|.. ExtraccionStrategy
TransaccionStrategy <|.. TransferenciaStrategy

' Apilado vertical de las estrategias concretas
DepositoStrategy -[hidden]down- ExtraccionStrategy
ExtraccionStrategy -[hidden]down- TransferenciaStrategy

@enduml
