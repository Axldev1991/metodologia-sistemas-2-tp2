@startuml diagrama_heroes
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam linetype ortho
skinparam class {
    BackgroundColor White
    ArrowColor #2C3E50
    BorderColor #2C3E50
}

title Patrón Combinado: Factory Method + Singleton + Facade (Punto 5)

' Fachada y Singleton (Arriba)
class GestorCentralHeroes <<Singleton>> <<Facade>> {
    - {static} instancia: GestorCentralHeroes
    - heroesRegistrados: List<Heroe>
    - GestorCentralHeroes()
    + {static} getInstancia(): GestorCentralHeroes
    + reclutarGuerrero(nombre: String, apodo: String, ataque: double, victorias: int, bono: double): GuerreroHeroe
    + reclutarMago(nombre: String, apodo: String, mana: double): MagoHeroe
    + consultarMejorGuerrero(): GuerreroHeroe
    + generarReporteBatalla(): String
    + getHeroesRegistrados(): List<Heroe>
}

' Columna Izquierda: Jerarquía de Productos (Héroes)
abstract class Heroe <<Product>> {
    - nombre: String
    - apodo: String
    - fechaCreacion: LocalDate
    + Heroe(nombre: String, apodo: String, fechaCreacion: LocalDate)
    + getNombre(): String
    + getApodo(): String
    + getFechaCreacion(): LocalDate
    + {abstract} calcularPoderTotal(): double
    + {abstract} getDescripcionTipo(): String
}

class GuerreroHeroe <<ConcreteProduct>> {
    - poderAtaque: double
    - victorias: int
    - bonoPorVictoria: double
    + calcularPoderTotal(): double
    + getDescripcionTipo(): String
}

class MagoHeroe <<ConcreteProduct>> {
    - reservaMana: double
    + calcularPoderTotal(): double
    + getDescripcionTipo(): String
}

' Columna Derecha: Jerarquía de Creadores (Factory Method)
abstract class CreadorHeroe <<Creator>> {
    + {abstract} crearHeroe(datos: DatosCreacionHeroe): Heroe
}

class CreadorGuerrero <<ConcreteCreator>> {
    + crearHeroe(datos: DatosCreacionHeroe): Heroe
}

class CreadorMago <<ConcreteCreator>> {
    + crearHeroe(datos: DatosCreacionHeroe): Heroe
}

' Relaciones del Singleton / Fachada
GestorCentralHeroes -down-> "1\n-creadorGuerrero" CreadorHeroe
GestorCentralHeroes -down-> "1\n-creadorMago" CreadorHeroe
GestorCentralHeroes -down-> "*\n-heroesRegistrados" Heroe

' Separación de columnas (Héroes a la izquierda, Creadores a la derecha)
Heroe -[hidden]right- CreadorHeroe

' Herencia de Héroes (Columna izquierda)
GuerreroHeroe -up-|> Heroe
MagoHeroe -left-|> Heroe
GuerreroHeroe -[hidden]down- MagoHeroe

' Herencia de Creadores (Columna derecha)
CreadorHeroe <|-- CreadorGuerrero
CreadorHeroe <|-- CreadorMago
CreadorGuerrero -[hidden]down- CreadorMago

' Dependencias de Creación (desde Creadores a la izquierda hacia Héroes)
CreadorGuerrero -left..> GuerreroHeroe
CreadorMago -left..> MagoHeroe

@enduml